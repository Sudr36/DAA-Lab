set terminal pdfcairo
set output "linear_search.pdf"

set title "Linear Search - Iterative vs Recursive - O(n)"
set xlabel "Input Size (n)"
set ylabel "Execution Time (seconds)"
set grid
set logscale y

plot "linear_results.dat" using 1:2 with linespoints linewidth 2 pointtype 7 title "Iterative O(n)", \
     "linear_results.dat" using 1:3 with linespoints linewidth 2 pointtype 7 title "Recursive O(n)"

unset output

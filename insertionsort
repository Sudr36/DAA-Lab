#include <stdio.h>
#include <stdlib.h>
#include <time.h>

void insertion(int a[], int n)
{
    int key, j;

    if (n <= 1)
        return;

    insertion(a, n - 1);

    key = a[n - 1];
    j = n - 2;

    while (j >= 0 && a[j] > key)
    {
        a[j + 1] = a[j];
        j--;
    }

    a[j + 1] = key;
}

int main()
{
    int n, i;
    int *a;
    clock_t start, end;
    double time;
    FILE *fp;

    srand(time(NULL));
    fp = fopen("insertion.dat", "w");

    printf("Recursive Insertion Sort\n");
    printf("-------------------------------\n");
    printf("n\tTime (seconds)\n");

    for (n = 100; n <= 5000; n += 100)
    {
        a = malloc(n * sizeof(int));

        for (i = 0; i < n; i++)
            a[i] = rand() % 10000;

        start = clock();
        insertion(a, n);
        end = clock();

        time = (double)(end - start) / CLOCKS_PER_SEC;

        printf("%d\t%.6f\n", n, time);
        fprintf(fp, "%d %.6f\n", n, time);

        free(a);
    }

    fclose(fp);

    printf("-------------------------------\n");
    printf("Data saved in insertion.dat\n");

    return 0;
}

set terminal pdfcairo enhanced font "Arial,14" size 10,7
set output "binary_search.pdf"

set title "Binary Search - Iterative vs Recursive - O(log n)"
set xlabel "Input Size (n)"
set ylabel "Execution Time (seconds)"

set grid
set key top left

plot "binary_results.dat" using 1:2 with linespoints linewidth 2 pointtype 7 title "Iterative O(log n)", \
     "binary_results.dat" using 1:3 with linespoints linewidth 2 pointtype 5 title "Recursive O(log n)"

unset output

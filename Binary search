#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int compare(const void *a, const void *b)
{
    return (*(int *)a - *(int *)b);
}

int binaryIterative(int a[], int n, int key)
{
    int low = 0;
    int high = n - 1;

    while (low <= high)
    {
        int mid = low + (high - low) / 2;

        if (a[mid] == key)
            return mid;

        if (key < a[mid])
            high = mid - 1;
        else
            low = mid + 1;
    }

    return -1;
}

int binaryRecursive(int a[], int low, int high, int key)
{
    if (low > high)
        return -1;

    int mid = low + (high - low) / 2;

    if (a[mid] == key)
        return mid;

    if (key < a[mid])
        return binaryRecursive(a, low, mid - 1, key);

    return binaryRecursive(a, mid + 1, high, key);
}

int main()
{
    int sizes[] = {
        1000,
        2000,
        4000,
        8000,
        16000,
        32000,
        64000,
        128000,
        256000,
        512000
    };

    int count = 10;
    int repeat = 1000000;

    FILE *fp = fopen("binary_results.dat", "w");

    if (fp == NULL)
    {
        printf("File error\n");
        return 1;
    }

    srand(time(NULL));

    fprintf(fp, "# n Iterative Recursive\n");

    printf("n\t\tIterative\tRecursive\n");

    for (int s = 0; s < count; s++)
    {
        int n = sizes[s];

        int *a = malloc(n * sizeof(int));

        if (a == NULL)
        {
            printf("Memory allocation failed\n");
            fclose(fp);
            return 1;
        }

        for (int i = 0; i < n; i++)
            a[i] = rand() % 10000000;

        qsort(a, n, sizeof(int), compare);

        int key = -1;
        int result;

        clock_t start, end;

        start = clock();

        for (int r = 0; r < repeat; r++)
            result = binaryIterative(a, n, key);

        end = clock();

        double iterativeTime =
            (double)(end - start) / CLOCKS_PER_SEC;

        start = clock();

        for (int r = 0; r < repeat; r++)
            result = binaryRecursive(a, 0, n - 1, key);

        end = clock();

        double recursiveTime =
            (double)(end - start) / CLOCKS_PER_SEC;

        printf("%d\t\t%.6f\t%.6f\n",
               n, iterativeTime, recursiveTime);

        fprintf(fp, "%d %.6f %.6f\n",
                n, iterativeTime, recursiveTime);

        free(a);
    }

    fclose(fp);

    return 0;
}

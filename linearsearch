#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int linearIterative(int a[], int n, int key)
{
    for (int i = 0; i < n; i++)
    {
        if (a[i] == key)
            return i;
    }
    return -1;
}

int linearRecursive(int a[], int n, int key, int i)
{
    if (i == n)
        return -1;

    if (a[i] == key)
        return i;

    return linearRecursive(a, n, key, i + 1);
}

int main()
{
    int sizes[] = {1000, 5000, 10000, 20000, 50000};
    int count = 5;
    int repeat = 1000;

    FILE *fp = fopen("linear_results.dat", "w");

    srand(time(NULL));

    fprintf(fp, "# n Iterative Recursive\n");

    printf("n\tIterative\tRecursive\n");

    for (int s = 0; s < count; s++)
    {
        int n = sizes[s];

        int *a = malloc(n * sizeof(int));

        for (int i = 0; i < n; i++)
            a[i] = rand() % 1000000;

        int key = -1;

        volatile int result;

        clock_t start, end;

        start = clock();

        for (int r = 0; r < repeat; r++)
            result = linearIterative(a, n, key);

        end = clock();

        double iterativeTime =
            (double)(end - start) / CLOCKS_PER_SEC / repeat;

        start = clock();

        for (int r = 0; r < repeat; r++)
            result = linearRecursive(a, n, key, 0);

        end = clock();

        double recursiveTime =
            (double)(end - start) / CLOCKS_PER_SEC / repeat;

        printf("%d\t%.10f\t%.10f\n",
               n, iterativeTime, recursiveTime);

        fprintf(fp, "%d %.10f %.10f\n",
                n, iterativeTime, recursiveTime);

        free(a);
    }

    fclose(fp);

    return 0;
}
